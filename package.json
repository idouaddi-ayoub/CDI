{
  "name": "cdi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate --config ./config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./config/drizzle.config.ts",
    "db:pull": "drizzle-kit pull --config ./config/drizzle.config.ts",
    "db:auth:generate": "pnpx @better-auth/cli@latest generate --config ./layers/auth/server/lib/auth.ts",
    "db:auth:migrate": "pnpx @better-auth/cli@latest migrate --config ./layers/auth/server/lib/auth.ts",
    "db:push": "drizzle-kit push --config ./config/drizzle.config.ts",
    "db:start": "pnpx supabase start",
    "db:stop": "pnpx supabase stop",
    "db:status": "pnpx supabase status"
  },
  "dependencies": {
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "10.3.0",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@tresjs/nuxt": "^5.6.3",
    "@tresjs/post-processing": "^3.7.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/simple-icons": "^1.2.94",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.185.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.8.3",
    "supabase": "^2.116.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "zod": "^4.5.4"
  }
}
